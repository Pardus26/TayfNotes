<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main "T" Shape Body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,30 h40 v8 h-16 v40 h-8 v-40 h-16 z" />

    <!-- Premium Spectrum Accent on the "T" Top Bar -->
    <path
        android:pathData="M34,30 h40 v3 h-40 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="30"
                android:endX="74"
                android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="@color/spectrum_red" />
                <item android:offset="0.2" android:color="@color/spectrum_orange" />
                <item android:offset="0.4" android:color="@color/spectrum_yellow" />
                <item android:offset="0.6" android:color="@color/spectrum_green" />
                <item android:offset="0.8" android:color="@color/spectrum_blue" />
                <item android:offset="1.0" android:color="@color/spectrum_purple" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized Pen/Note corner detail -->
    <path
        android:fillColor="@color/premium_gold"
        android:pathData="M70,70 l8,8 v-8 z" />

</vector>
